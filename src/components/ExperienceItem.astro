---
import { Briefcase, ChevronDown } from '@lucide/astro';

interface Experience {
  role: string;
  company: string;
  period: string;
  summary?: string;
  functions: string[];
}

interface Props {
  job: Experience;
}

const { job } = Astro.props;
---

<details class="group overflow-hidden rounded-xl border border-line bg-surface-raised transition-colors duration-300 hover:border-line-strong">
  <summary class="flex cursor-pointer flex-col justify-between gap-3 p-5 select-none md:flex-row md:items-center">
    <div class="flex-1">
      <h3 class="font-bold text-ink">
        {job.role}
      </h3>
      <div class="mt-1 flex items-center gap-2 text-sm font-medium text-ink-muted">
        <Briefcase size={13} class="shrink-0" />
        {job.company}
      </div>
    </div>

    <div class="flex items-center gap-3">
      <span class="rounded-full border border-line bg-surface-sunken px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-ink-muted">
        {job.period}
      </span>
      <div class="chevron shrink-0 text-ink-subtle">
        <ChevronDown size={18} />
      </div>
    </div>
  </summary>

  <div class="exp-body">
    <div class="exp-inner">
      <div class="border-t border-line bg-surface-sunken/40 p-5">
        {job.summary && (
          <p class="mb-4 text-sm text-ink-subtle">{job.summary}</p>
        )}
        <ul class="space-y-2.5">
          {job.functions.map((fn) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-muted">
              <span class="mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              {fn}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</details>

<style>
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  .exp-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.32s ease;
  }

  details[open] .exp-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .exp-inner {
    overflow: hidden;
    min-height: 0;
  }

  .chevron {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }
</style>
