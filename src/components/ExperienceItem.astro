---
import GlassCard from './GlassCard.astro';
import { Briefcase, ChevronDown } from '@lucide/astro';

interface Experience {
  role: string;
  company: string;
  period: string;
  summary?: string;
  functions: string[];
}

interface Props {
  job: Experience;
}

const { job } = Astro.props;
---

<GlassCard className="p-0! overflow-hidden">
  <details>
    <summary class="p-6 cursor-pointer flex flex-col md:flex-row md:items-center justify-between gap-4
                    bg-white/40 hover:bg-white/60
                    dark:bg-zinc-900/40 dark:hover:bg-zinc-900/60
                    transition-colors select-none">
      <div class="flex-1">
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">
          {job.role}
        </h3>
        <div class="text-gray-500 dark:text-gray-400 font-medium text-sm flex items-center gap-2 mt-0.5">
          <Briefcase size={13} />
          {job.company}
        </div>
      </div>

      <div class="flex items-center gap-4">
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full
                     bg-gray-100 text-gray-600 border border-gray-200
                     dark:bg-zinc-800 dark:text-gray-300 dark:border-zinc-700 whitespace-nowrap">
          {job.period}
        </span>
        <div class="chevron text-gray-400 dark:text-gray-500 shrink-0">
          <ChevronDown size={18} />
        </div>
      </div>
    </summary>

    <div class="exp-body">
      <div class="exp-inner">
        <div class="p-6 border-t border-gray-100/60 bg-white/20 dark:border-zinc-700/50 dark:bg-zinc-900/20">
          {job.summary && (
            <p class="text-gray-500 dark:text-gray-400 mb-4 text-sm italic">{job.summary}</p>
          )}
          <ul class="space-y-2.5">
            {job.functions.map((fn) => (
              <li class="flex items-start gap-2.5 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-main-color/70 shrink-0" />
                {fn}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </details>
</GlassCard>

<style>
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  .exp-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.32s ease;
  }

  details[open] .exp-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .exp-inner {
    overflow: hidden;
    min-height: 0;
  }

  .chevron {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }
</style>
