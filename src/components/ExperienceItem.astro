---
import { Plus, Minus } from '@lucide/astro';

interface Experience {
  role: string;
  company: string;
  period: string;
  summary?: string;
  functions: string[];
}

interface Props {
  job: Experience;
}

const { job } = Astro.props;
---

<details class="group border-b border-line">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 select-none">
    <div class="min-w-0">
      <h3 class="text-lg font-medium tracking-tight text-ink">
        {job.role}
      </h3>
      <p class="mt-1 text-sm text-ink-muted">
        {job.company}
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-5">
      <span class="hidden font-mono text-xs whitespace-nowrap text-ink-subtle sm:block">
        {job.period}
      </span>
      <span class="text-ink-subtle transition-colors group-hover:text-ink">
        <Plus size={16} class="toggle-open" />
        <Minus size={16} class="toggle-close hidden" />
      </span>
    </div>
  </summary>

  <div class="exp-body">
    <div class="exp-inner">
      <div class="pb-7">
        <p class="mb-4 font-mono text-xs text-ink-subtle sm:hidden">{job.period}</p>
        {job.summary && (
          <p class="mb-4 text-sm text-ink-subtle">{job.summary}</p>
        )}
        <ul class="max-w-2xl space-y-3">
          {job.functions.map((fn) => (
            <li class="flex items-start gap-3 text-sm leading-[1.7] text-ink-muted">
              <span class="mt-[0.65em] h-px w-3 shrink-0 bg-line-strong" />
              {fn}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] .toggle-open {
    display: none;
  }

  details[open] .toggle-close {
    display: block;
  }

  .exp-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.32s ease;
  }

  details[open] .exp-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .exp-inner {
    overflow: hidden;
    min-height: 0;
  }
</style>
