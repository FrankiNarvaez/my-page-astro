---
interface Props {
  icon: any;
  title: string;
}

const { icon: Icon, title } = Astro.props;
---

<div class="mb-7 flex items-center gap-3">
  <div class="rounded-lg border border-line bg-surface-raised p-2.5 text-ink-muted">
    <Icon size={20} strokeWidth={1.5} />
  </div>

  <h2 class="text-xl font-semibold tracking-tight text-ink md:text-2xl">
    {title}
  </h2>

  <div class="h-px flex-1 bg-line" aria-hidden="true"></div>
</div>
