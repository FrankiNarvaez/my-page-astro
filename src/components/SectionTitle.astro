---
interface Props {
  icon: any;
  title: string;
}

const { icon: Icon, title } = Astro.props;
---

<div class="mb-10 flex items-center gap-3 border-b border-line pb-5" data-reveal>
  <Icon size={18} strokeWidth={1.5} class="shrink-0 text-ink-subtle" />
  <h2 class="text-2xl font-medium tracking-tight text-ink md:text-3xl">
    {title}
  </h2>
</div>
