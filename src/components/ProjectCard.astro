---
import { ExternalLink, Github, Lock } from '@lucide/astro'

interface Props {
	title: string;
  description: string;
  technologies: string[];
  github?: string;
  demo?: string;
  type: string;
}

const { title, technologies, github, demo, description, type } = Astro.props;
---

<article class="flex h-full flex-col rounded-xl border-[0.5px] border-line bg-surface-raised p-5 transition-colors duration-200 hover:border-line-strong">
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-[15px] leading-snug font-medium text-ink">{title}</h3>
    <span class="shrink-0 pt-0.5 font-mono text-[11px] text-ink-subtle">{type}</span>
  </div>

  <p class="mt-2 mb-3.5 flex-1 text-[13px] leading-relaxed text-ink-muted">
    {description}
  </p>

  <ul class="mb-4 flex flex-wrap gap-1.5">
    {technologies.map((tech) => (
      <li class="rounded border-[0.5px] border-line px-2 py-[3px] font-mono text-[11px] text-ink-muted">
        {tech}
      </li>
    ))}
  </ul>

  <div class="flex flex-wrap gap-4 border-t-[0.5px] border-line pt-3">
    {github ? (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs text-ink-muted transition-colors hover:text-ink"
      >
        <Github size={14} class="shrink-0" />
        Repository
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 text-xs text-ink-subtle">
        <Lock size={14} class="shrink-0" />
        Private repo
      </span>
    )}

    {demo && (
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs text-ink-muted transition-colors hover:text-ink"
      >
        <ExternalLink size={14} class="shrink-0" />
        Live site
      </a>
    )}
  </div>
</article>
