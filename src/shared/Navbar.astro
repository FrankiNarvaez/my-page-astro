---
import { Github, Linkedin, Moon, Sun, Menu, X } from '@lucide/astro'
import { Image } from 'astro:assets'

import MrCat from '../assets/mrcat.jpeg'

const navLinks = [
  { href: '/#Home', label: 'Home' },
  { href: '/#Experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/#About', label: 'About' },
  { href: '/#skills', label: 'Skills' },
];

const socials = [
  { href: 'https://www.linkedin.com/in/franki-jhan-carlos-narvaez-munoz-a04bb0319/', icon: Linkedin, label: 'Visit my LinkedIn profile' },
  { href: 'https://github.com/FrankiNarvaez', icon: Github, label: 'Visit my GitHub profile' },
];
---

<!-- Sentinel for the scroll state. An IntersectionObserver on this element
     replaces a scroll listener, which fired on every frame. -->
<div id="scroll-sentinel" aria-hidden="true"></div>

<header class="fixed inset-x-0 top-0 z-30" id="main-header">
  <div class="container-page pt-0 transition-[padding] duration-300" id="header-shell">
    <div
      class="flex items-center justify-between gap-4 rounded-lg border border-transparent px-4 py-3 transition-all duration-300"
      id="header-bar"
    >
      <a
        class="flex shrink-0 items-center gap-2 text-lg font-black text-ink transition-opacity hover:opacity-70"
        href="/"
      >
        <Image
          src={MrCat}
          alt=""
          class="h-9 w-9 rounded-full object-cover transition-all duration-300"
          id="header-logo"
          draggable="false"
        />
        Franki
      </a>

      <nav class="hidden md:block" aria-label="Main">
        <ul class="flex items-center gap-1 text-sm font-semibold">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-1">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="hidden rounded-md p-2 text-ink-muted transition-colors hover:text-ink md:inline-flex"
          >
            <social.icon size={18} />
          </a>
        ))}

        <button
          type="button"
          class="theme-btn rounded-md p-2 text-ink-muted transition-colors hover:text-ink"
          aria-label="Toggle color theme"
        >
          <Moon size={18} class="block dark:hidden" />
          <Sun size={18} class="hidden dark:block" />
        </button>

        <button
          type="button"
          id="menu-toggle"
          class="rounded-md p-2 text-ink-muted transition-colors hover:text-ink md:hidden"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu size={18} class="menu-icon-open" />
          <X size={18} class="menu-icon-close hidden" />
        </button>
      </div>
    </div>

    <div class="mobile-menu md:hidden" id="mobile-menu">
      <div class="mobile-menu-inner">
        <nav
          class="mt-2 rounded-lg border border-line bg-surface-raised/95 p-2 backdrop-blur-xl"
          aria-label="Mobile"
        >
          <ul class="flex flex-col text-sm font-semibold">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-md px-3 py-2.5 text-ink-muted transition-colors hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-1 flex gap-1 border-t border-line pt-2">
            {socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="rounded-md p-2.5 text-ink-muted transition-colors hover:text-ink"
              >
                <social.icon size={18} />
              </a>
            ))}
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme toggle. The initial class is applied inline in <head> to avoid a flash.
  document.querySelectorAll('.theme-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  // Mobile menu
  const menuToggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const mobileMenu = document.querySelector<HTMLDivElement>('#mobile-menu');

  if (menuToggle && mobileMenu) {
    const setMenu = (open: boolean) => {
      mobileMenu.classList.toggle('is-open', open);
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      menuToggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      menuToggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
    };

    menuToggle.addEventListener('click', () => {
      setMenu(!mobileMenu.classList.contains('is-open'));
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenu(false);
    });
  }

  // Condensed header state, driven by a sentinel instead of a scroll listener.
  const sentinel = document.querySelector('#scroll-sentinel');
  const shell = document.querySelector('#header-shell');
  const bar = document.querySelector('#header-bar');
  const logo = document.querySelector('#header-logo');

  if (sentinel && shell && bar && logo) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const scrolled = !entry.isIntersecting;
        shell.classList.toggle('pt-3', scrolled);
        bar.classList.toggle('is-condensed', scrolled);
        logo.classList.toggle('h-8', scrolled);
        logo.classList.toggle('w-8', scrolled);
        logo.classList.toggle('h-9', !scrolled);
        logo.classList.toggle('w-9', !scrolled);
      },
      { rootMargin: '-72px 0px 0px 0px' }
    );
    observer.observe(sentinel);
  }
</script>

<style>
  #scroll-sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 100%;
  }

  /* The condensed bar needs a real surface. Previously it only had
     backdrop-blur, so the shadow floated on nothing. */
  #header-bar.is-condensed {
    background-color: color-mix(in srgb, var(--surface-raised) 85%, transparent);
    border-color: var(--line);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    padding-block: 0.5rem;
  }

  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .mobile-menu-inner {
    overflow: hidden;
    min-height: 0;
  }
</style>
