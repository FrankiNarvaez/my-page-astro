---
import Layout from '../layouts/Layout.astro';
import Project from '../components/ProjectCard.astro';

import { ChevronLeft } from '@lucide/astro';
---
<Layout
  title="Jhan Carlos | Projects"
  description="Web applications and tools built by Jhan Carlos Narvaez, from Rails and Nest APIs to React and Next.js frontends."
>
  <main class="container-page pt-28 pb-16">
    <a
      href="/#projects"
      class="group inline-flex items-center gap-2 rounded-lg border border-line bg-surface-raised px-4 py-2.5 text-sm font-medium text-ink-muted transition-all duration-200 hover:border-line-strong hover:text-accent"
    >
      <ChevronLeft size={16} class="transition-transform duration-200 group-hover:-translate-x-0.5" />
      Go back
    </a>

    <div class="mt-8 mb-10 max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">Projects</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-muted">
        A collection of projects I have <span class="font-medium text-accent">developed and collaborated on</span>, from web applications and internal tools to team builds. Take a closer look at each one and see how I turn ideas into working software.
      </p>
    </div>

    <section class="grid grid-cols-[repeat(auto-fit,minmax(17.5rem,1fr))] gap-4">
      <Project
        title='Social Media'
        description='Social media where you can upload posts, see posts, follow people, and more.'
        technologies={['Nextjs', 'Tailwind', 'Nestjs', 'TypeScript', 'PostgreSQL', 'AWS', 'TypeORM']}
        github='https://github.com/orgs/FullStack-Elite-Bootcamp-IV/repositories'
        type="FullStack"
      />
      <Project
        title='Virtual Store'
        description='A simple E-commerce with core features: browse products, login, register, and add to cart.'
        technologies={['React', 'TypeScript', 'Tailwind', 'Nestjs', 'TypeORM', 'PostgreSQL']}
        github='https://github.com/FrankiNarvaez/frontend-virtual-store'
        type="FullStack"
      />
      <Project
        title='Memory Game'
        description='A simple memory game made with HTML without JavaScript.'
        technologies={['HTML5', 'CSS3']}
        github='https://github.com/FrankiNarvaez/memory-game'
        demo='https://memory-game-html5-css3.netlify.app/'
        type="FrontEnd"
      />
      <Project
        title='IMDb Page'
        description='IMDB page to search for movies and series, and see their details.'
        technologies={['React', 'JavaScript']}
        github='https://github.com/FrankiNarvaez/IMDB-page'
        demo='https://imdb-pag.netlify.app/'
        type="FrontEnd"
      />
      <Project
        title='Finance'
        description='Manage your personal finances.'
        technologies={['Rails', 'PostgreSQL']}
        github='https://github.com/FrankiNarvaez/Finance'
        demo='https://finance.jhancarlos.me'
        type="FullStack"
      />
      <Project
        title='Eccomerce'
        description='E-commerce built with Ruby On Rails. Create an account, list your products, and more.'
        technologies={['Rails', 'PostgreSQL']}
        github='https://github.com/FrankiNarvaez/E-commerce-Rails'
        type="FullStack"
      />
    </section>
  </main>
</Layout>
