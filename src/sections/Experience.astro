---
import ExperienceItem from '../components/ExperienceItem.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { Briefcase } from '@lucide/astro';

interface Experience {
  role: string;
  company: string;
  period: string;
  summary?: string;
  functions: string[];
}

const experiences: Experience[] = [
  {
    role: "Junior Developer",
    company: "Code and Theory Colombia",
    period: "Aug 2026 - Present",
    summary: "Continuation of the contract transferred from Qstrauss Consulting through a formal assignment, with unbroken tenure.",
    functions: [
      "Automation, reporting and integration work on Adobe Workfront, continuing the scope started at Qstrauss Consulting."
    ],
  },
  {
    role: "Junior Developer",
    company: "Qstrauss Consulting",
    period: "Oct 2025 - Aug 2026",
    functions: [
      "Built automation flows, custom reports and integrations in Adobe Workfront and Workfront Fusion, connecting Workfront with Salesforce, SharePoint and Google Sheets.",
      "Troubleshot Fusion-Salesforce integrations, including SOQL date filtering over OpportunityLineItem using relative date literals and Fusion-computed dates.",
      "Designed a capacity tracking system that measures project creation volume by medium/format combination against minimum and maximum thresholds defined in Google Sheets.",
      "Designed a parallel control hierarchy in Workfront (Portfolio, Program, Project, Task) to count real projects without altering the existing structure.",
      "Standardized documentation generated from Fusion JSON blueprints, including Mermaid diagrams and Word documents following a defined style guide.",
      "Built text mode reports in Workfront with task counts, conditional color formatting through custom calculated fields, and grouping by parent task or program.",
      "Contributed backend work to the Decisor Renew platform and set up GitHub Actions workflows for Rails deployments over VPN and SSH."
    ],
  },
  {
    role: "Full-Stack Developer",
    company: "Universidad Tecnológica de Pereira",
    period: "Oct 2024 - Oct 2025",
    functions: [
      "Analyzed and understood an arrhythmia detection model, defining its input/output requirements and performance metrics to facilitate its integration into the application.",
      "Implemented the model in a Ruby on Rails application, creating services, APIs, and views that displayed cardiological results in real time, reducing clinical response time and improving the user experience.",
      "Performed project migration from Rails 5.2.2 to Rails 8.0.2, updating gems and resolving breaking changes, which decreased code reading complexity.",
      "Provided Level 2/3 support for a private platform.",
      "Collaborated in the development and optimization of the software's technical documentation, facilitating its implementation and maintenance.",
      "Performed extensive functional and performance tests to ensure system stability and efficiency.",
      "Developed an automation script for the installation of dependencies and software deployment, facilitating the continuous integration process.",
      "Developed and optimized various functions in Ruby for a private project, enhancing system performance and maintainability."
    ],
  },
  {
    role: "Teaching Assistant",
    company: "Universidad Tecnológica de Pereira",
    period: "Sep 2023 - Nov 2023",
    functions: [
      "Collaborated closely with my professor to guide students in learning and practical application of fundamental C language concepts."
    ],
  }
];
---

<section id="Experience" class="scroll-mt-24 py-24 md:py-32">
  <SectionTitle icon={Briefcase} title="Experience" />
  <div class="border-t border-line" data-reveal>
    {experiences.map((exp) => (
      <ExperienceItem job={exp} />
    ))}
  </div>
</section>
