---
import { Github, Linkedin, Mail } from '@lucide/astro'

const socialMedias = [
  {
    href: "https://www.linkedin.com/in/franki-jhan-carlos-narvaez-munoz-a04bb0319/",
    icon: Linkedin,
    name: "LinkedIn"
  },
  {
    href: "https://github.com/FrankiNarvaez",
    icon: Github,
    name: "GitHub"
  },
  {
    href: "mailto:frannki03@gmail.com",
    icon: Mail,
    name: "frannki03@gmail.com"
  }
]
---
<section id='Home' class='flex min-h-[100dvh] scroll-mt-20 flex-col justify-center pt-24 pb-24'>
  <h1
    class='text-5xl leading-[1.05] font-medium tracking-[-0.03em] text-ink md:text-6xl lg:text-7xl'
    data-reveal
  >
    Hi! I'm Jhan Carlos
  </h1>

  <div class="mt-6 flex flex-wrap items-center gap-3" data-reveal style="--index: 1">
    <p class='text-lg text-ink-muted lg:text-xl'>
      Full-Stack Developer
    </p>
    <span class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-[11px] tracking-wider uppercase text-ink-subtle">
      <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
      Not available
    </span>
  </div>

  <p class="mt-8 max-w-xl text-base leading-[1.7] text-ink-muted" data-reveal style="--index: 2">
    Computer science student from Colombia, building <span class="text-accent">robust full-stack web solutions</span> with clean code and production-ready systems.
  </p>

  <div class="mt-10 flex flex-wrap gap-2" data-reveal style="--index: 3">
    {socialMedias.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-line px-3.5 py-2 text-sm text-ink-muted transition-colors duration-200 hover:border-line-strong hover:text-ink active:scale-[0.98]"
      >
        <social.icon size={15} class='shrink-0' />
        {social.name}
      </a>
    ))}
  </div>
</section>
