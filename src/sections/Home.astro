---
import { Github, Linkedin, Mail } from '@lucide/astro'

const socialMedias = [
  {
    href: "https://www.linkedin.com/in/franki-jhan-carlos-narvaez-munoz-a04bb0319/",
    icon: Linkedin,
    name: "LinkedIn"
  },
  {
    href: "https://github.com/FrankiNarvaez",
    icon: Github,
    name: "GitHub"
  },
  {
    href: "mailto:frannki03@gmail.com",
    icon: Mail,
    name: "frannki03@gmail.com"
  }
]
---
<section id='Home' class='flex flex-col justify-center min-h-[100dvh] pt-28 pb-16 scroll-mt-20'>
  <div class='flex flex-col'>
    <div class="w-fit mb-4 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/40 border border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider dark:bg-white/10 dark:border-gray-700 dark:text-gray-300">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
      Not available for projects
    </div>
    <h1 class='text-gray-black dark:text-text-white text-5xl lg:text-7xl font-bold tracking-tight leading-[1.1]'>Hi! I'm Jhan Carlos</h1>
    <h2 class='text-gray-black/60 dark:text-white-color/50 text-lg lg:text-xl font-medium mt-2 tracking-widest uppercase'>Full-Stack Developer</h2>
    <p class="text-gray-black/80 dark:text-text-white mt-8 text-base lg:text-lg max-w-sm lg:max-w-xl leading-relaxed">
      Computer science student from Colombia, building <span class="text-main-color font-medium">robust full-stack web solutions</span>. Passionate about clean code, efficient systems, and turning ideas into production-ready software.
    </p>
    <div class="flex gap-3 mt-8 flex-wrap">
      {socialMedias.map((social) => (
        <a
          href={social.href}
          target="_blank"
          class="bg-white/60 border border-gray-200 dark:bg-zinc-800/60 dark:border-zinc-700 rounded-xl flex items-center gap-2 py-2 px-3 hover:scale-105 hover:shadow-sm transition-all duration-200 text-gray-black dark:text-text-white text-sm"
          >
          <social.icon size={16} class='text-gray-black dark:text-text-white shrink-0' />
          {social.name}
        </a>
      ))}
    </div>
  </div>
</section>
