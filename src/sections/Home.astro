---
import { Github, Linkedin, Mail } from '@lucide/astro'

const socialMedias = [
  {
    href: "https://www.linkedin.com/in/franki-jhan-carlos-narvaez-munoz-a04bb0319/",
    icon: Linkedin,
    name: "LinkedIn"
  },
  {
    href: "https://github.com/FrankiNarvaez",
    icon: Github,
    name: "GitHub"
  },
  {
    href: "mailto:frannki03@gmail.com",
    icon: Mail,
    name: "frannki03@gmail.com"
  }
]
---
<section id='Home' class='flex min-h-[100dvh] scroll-mt-20 flex-col justify-center pt-24 pb-16'>
  <h1 class='text-4xl leading-[1.1] font-bold tracking-tight text-ink md:text-5xl lg:text-6xl'>
    Hi! I'm Jhan Carlos
  </h1>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <p class='text-lg font-medium tracking-wide text-ink-muted lg:text-xl'>
      Full-Stack Developer
    </p>
    <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-raised px-3 py-1 text-xs font-semibold text-ink-muted">
      <span class="h-2 w-2 animate-pulse rounded-full bg-red-500"></span>
      Not available for projects
    </span>
  </div>

  <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-muted lg:text-lg">
    Computer science student from Colombia, building <span class="font-medium text-accent">robust full-stack web solutions</span> with clean code and production-ready systems.
  </p>

  <div class="mt-8 flex flex-wrap gap-2.5">
    {socialMedias.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface-raised px-3.5 py-2 text-sm text-ink-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:text-accent active:translate-y-0"
      >
        <social.icon size={16} class='shrink-0' />
        {social.name}
      </a>
    ))}
  </div>
</section>
